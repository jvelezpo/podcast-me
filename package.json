{
  "name": "podcast-me",
  "main": "expo-router/entry",
  "version": "1.0.24",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/ui": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tamagui/config": "^2.7.7",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-audio": "57.0.4",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "patch-package": "8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.7.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare": "node ./scripts/install-git-hooks.js",
    "test:version": "node --test tests/version-hook.test.js",
    "test:android-auto-build": "node --test tests/android-auto-build.test.js",
    "verify:android-auto": "node scripts/verify-android-auto.js",
    "eas-build-on-success": "node scripts/verify-android-auto.js",
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start --tunnel",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuild:dev:android": "APP_VARIANT=development expo prebuild --clean --platform android",
    "prebuild:dev:ios": "APP_VARIANT=development expo prebuild --clean --platform ios",
    "android:expo": "expo start --android",
    "ios:expo": "expo start --ios",
    "android:dev": "npm run prebuild:dev:android && APP_VARIANT=development expo run:android && APP_VARIANT=development node scripts/verify-android-auto.js android/app/build/outputs/apk/debug/app-debug.apk",
    "android:dev:all": "npm run android:dev",
    "ios:dev": "APP_VARIANT=development expo run:ios",
    "ios:dev:all": "npm run prebuild:dev:ios && APP_VARIANT=development expo run:ios",
    "prebuild:production:android": "APP_VARIANT=production expo prebuild --clean --platform android",
    "prebuild:production:ios": "APP_VARIANT=production expo prebuild --clean --platform ios",
    "android": "npm run prebuild:production:android && APP_VARIANT=production expo run:android && APP_VARIANT=production node scripts/verify-android-auto.js android/app/build/outputs/apk/debug/app-debug.apk",
    "ios": "npm run prebuild:production:ios && APP_VARIANT=production expo run:ios",
    "build:android:production": "eas build --platform android --profile production-apk",
    "build:android:production:local": "source .env && GRADLE_OPTS='-Dorg.gradle.jvmargs=\"-Xmx4096m -XX:MaxMetaspaceSize=1536m -Dfile.encoding=UTF-8\" -Dorg.gradle.workers.max=2' eas build --platform android --profile production-apk --local --output ./dist/podcast-me-production-$(date +%Y%m%d-%H%M%S).apk",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:playstore": "eas build --platform android --profile production --local --output ./build-production.aab",
    "submit:playstore": "eas submit --platform android --path ./build-production.aab"
  },
  "private": true
}
