+package expo.modules.audio
+
+import androidx.media3.common.AudioAttributes
+import androidx.media3.common.C
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.ExoPlayer
+
+@UnstableApi
+internal fun ExoPlayer.configureAudioFocus(interruptionMode: InterruptionMode?) {
+  val exclusive = interruptionMode == InterruptionMode.DO_NOT_MIX
+  val attributes = if (exclusive) {
+    // Podcast playback needs permanent media focus and must pause for spoken interruptions.
+    AudioAttributes.Builder()
+      .setUsage(C.USAGE_MEDIA)
+      .setContentType(C.AUDIO_CONTENT_TYPE_SPEECH)
+      .build()
+  } else {
+    AudioAttributes.DEFAULT
+  }
+  setAudioAttributes(attributes, exclusive)
+  setHandleAudioBecomingNoisy(true)
+}
