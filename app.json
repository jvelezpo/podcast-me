{
  "expo": {
    "name": "Podcast Me",
    "slug": "podcast-me",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/podcast-me-icon.png",
    "scheme": "podcastme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.podcastme.app"
    },
    "android": {
      "package": "com.podcastme.app",
      "icon": "./assets/images/podcast-me-icon-android-v2.png",
      "adaptiveIcon": {
        "backgroundColor": "#06142B",
        "foregroundImage": "./assets/images/podcast-me-foreground-v2.png",
        "monochromeImage": "./assets/images/podcast-me-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/podcast-me-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06142B",
          "image": "./assets/images/podcast-me-foreground.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
